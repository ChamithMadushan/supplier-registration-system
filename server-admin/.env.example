# Admin backend configuration (copy to .env)
PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# JWT settings
JWT_SECRET=change-me-admin-secret
JWT_EXPIRES_IN=8h
# Shared SQLite database (the whole system lives in one DB)
# Relative to this file's project root (server-admin/)
DB_PATH=../server/data/supplier.db
